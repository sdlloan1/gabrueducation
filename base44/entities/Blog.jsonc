{
  "name": "Blog",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "title": "Title (H1)"
    },
    "slug": {
      "type": "string",
      "title": "Slug"
    },
    "cover_image": {
      "type": "string",
      "title": "Cover image"
    },
    "excerpt": {
      "type": "string",
      "title": "Excerpt"
    },
    "content": {
      "type": "string",
      "title": "Content (Markdown)"
    },
    "category": {
      "type": "string",
      "title": "Category"
    },
    "tags": {
      "type": "array",
      "title": "Tags",
      "items": {
        "type": "string"
      }
    },
    "author": {
      "type": "string",
      "title": "Author"
    },
    "read_time": {
      "type": "number",
      "title": "Read time (min)",
      "default": 5
    },
    "focus_keyword": {
      "type": "string",
      "title": "Focus keyword"
    },
    "seo_title": {
      "type": "string",
      "title": "SEO title tag"
    },
    "seo_description": {
      "type": "string",
      "title": "Meta description"
    },
    "seo_keywords": {
      "type": "array",
      "title": "SEO keywords",
      "items": {
        "type": "string"
      }
    },
    "is_published": {
      "type": "boolean",
      "title": "Published",
      "default": true
    },
    "views": {
      "type": "number",
      "title": "Views",
      "default": 0
    }
  },
  "required": [
    "title",
    "slug"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}