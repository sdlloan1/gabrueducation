{
  "name": "SavedItem",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "title": "User id"
    },
    "product_id": {
      "type": "string",
      "title": "Product id"
    }
  },
  "required": [
    "user_id",
    "product_id"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}