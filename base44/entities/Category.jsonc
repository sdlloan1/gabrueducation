{
  "name": "Category",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "title": "Category name"
    },
    "slug": {
      "type": "string",
      "title": "Slug"
    },
    "image_url": {
      "type": "string",
      "title": "Category image"
    },
    "description": {
      "type": "string",
      "title": "Description"
    },
    "sort_order": {
      "type": "number",
      "title": "Sort order",
      "default": 0
    },
    "is_active": {
      "type": "boolean",
      "title": "Visible",
      "default": true
    },
    "seo_title": {
      "type": "string",
      "title": "SEO title"
    },
    "seo_description": {
      "type": "string",
      "title": "SEO description"
    }
  },
  "required": [
    "name",
    "slug"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}