{
  "name": "Review",
  "type": "object",
  "properties": {
    "product_id": {
      "type": "string",
      "title": "Product id"
    },
    "user_id": {
      "type": "string",
      "title": "Reviewer user id"
    },
    "name": {
      "type": "string",
      "title": "Reviewer name"
    },
    "avatar_url": {
      "type": "string",
      "title": "Profile photo"
    },
    "rating": {
      "type": "number",
      "title": "Rating (1-5)",
      "default": 5
    },
    "title": {
      "type": "string",
      "title": "Headline"
    },
    "comment": {
      "type": "string",
      "title": "Comment"
    },
    "images": {
      "type": "array",
      "title": "Photos",
      "items": {
        "type": "string"
      }
    },
    "is_verified": {
      "type": "boolean",
      "title": "Verified purchase",
      "default": false
    },
    "is_hidden": {
      "type": "boolean",
      "title": "Hidden",
      "default": false
    }
  },
  "required": [
    "product_id",
    "name",
    "rating"
  ],
  "rls": {
    "read": {},
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}